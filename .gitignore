# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*

# Client source photos (raw camera exports) — only the selected, cleaned
# copies under public/images/client/ are used by the site. Originals are kept
# OUT of the webroot (client-originals/) so they can never be served/deployed.
/client-originals/
/public/images/christmas/Client Provider/

# Runtime review store — created/updated by app/api/reviews (data/reviews.json).
/data/reviews.json

# Openverse search caches — transient rate-limit bypass. Keep only the
# downloads-record.json (audit trail: file -> source URL + license).
.unsplash-cache/openverse/*.json
!.unsplash-cache/openverse/downloads-record.json
